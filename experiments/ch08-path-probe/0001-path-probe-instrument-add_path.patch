+/*
+ * Path Probe: инструментовка add_path() для книги "Работающий PostgreSQL".
+ * Не является частью upstream PostgreSQL. Пишет в лог одну строку на
+ * каждое решение add_path(), чтобы было видно, какие Paths создавались и
+ * какой из них кого вытеснил.
+ *
+ * Включается на уровне сессии:  SET client_min_messages = debug1;
+ * Фильтровать по префиксу PATHPROBE.
+ */
+static void
+path_probe_log(const char *event, RelOptInfo *rel, Path *path)
+{
+	StringInfoData buf;
+	Relids		req_outer = PATH_REQ_OUTER(path);
+
+	initStringInfo(&buf);
+	appendStringInfo(&buf, "PATHPROBE %s rel=", event);
+	if (rel->relids)
+	{
+		int			x = -1;
+		bool		first = true;
+
+		while ((x = bms_next_member(rel->relids, x)) >= 0)
+		{
+			appendStringInfo(&buf, "%s%d", first ? "" : ",", x);
+			first = false;
+		}
+	}
+	else
+		appendStringInfoString(&buf, "?");
+
+	appendStringInfo(&buf, " node=%d startup=%.2f total=%.2f rows=%.0f pathkeys=%d req_outer=",
+					 (int) path->pathtype, path->startup_cost,
+					 path->total_cost, path->rows,
+					 list_length(path->pathkeys));
+	if (req_outer)
+	{
+		int			x = -1;
+		bool		first = true;
+
+		while ((x = bms_next_member(req_outer, x)) >= 0)
+		{
+			appendStringInfo(&buf, "%s%d", first ? "" : ",", x);
+			first = false;
+		}
+	}
+	else
+		appendStringInfoString(&buf, "none");
+
+	if (IsA(path, IndexPath))
+		appendStringInfo(&buf, " index=%u",
+						 ((IndexPath *) path)->indexinfo->indexoid);
+
+	elog(DEBUG1, "%s", buf.data);
+	pfree(buf.data);
+}
+
