diff --git a/src/test/modules/injection_points/t/001_planner_path_prune.pl b/src/test/modules/injection_points/t/001_planner_path_prune.pl
new file mode 100644
index 0000000..74d89d8
--- /dev/null
+++ b/src/test/modules/injection_points/t/001_planner_path_prune.pl
@@ -0,0 +1,88 @@
+
+# Copyright (c) 2026, PostgreSQL Global Development Group
+
+# Structural test for the planner path-pruning injection points.
+#
+# The NOTICE lines contain costs and row estimates, which are not stable
+# across platforms or planner changes, so this test does not compare the
+# output as a whole.  It asserts only the facts the instrumentation exists
+# for: that each kind of event can be observed, and that a parameterized
+# candidate is reported with a non-empty required_outer.
+
+use strict;
+use warnings FATAL => 'all';
+
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+if ($ENV{enable_injection_points} ne 'yes')
+{
+	plan skip_all => 'Injection points not supported by this build';
+}
+
+my $node = PostgreSQL::Test::Cluster->new('main');
+$node->init;
+$node->start;
+
+$node->safe_psql('postgres', 'CREATE EXTENSION injection_points;');
+
+my $setup = q{
+CREATE TABLE ppc (id int PRIMARY KEY);
+CREATE TABLE ppo (id int PRIMARY KEY, customer_id int NOT NULL);
+INSERT INTO ppc SELECT g FROM generate_series(1, 200) g;
+INSERT INTO ppo SELECT g, 1 + (g % 200) FROM generate_series(1, 20000) g;
+CREATE INDEX ppo_customer_idx ON ppo (customer_id);
+ANALYZE ppc, ppo;
+};
+$node->safe_psql('postgres', $setup);
+
+# A nested loop over the inner index is the shape that produces a
+# parameterized path.  The settings are here to make that shape reachable,
+# not to bless any particular cost.
+my $query = q{
+SELECT injection_points_set_local();
+SELECT injection_points_attach('planner-add-path-accept', 'path-prune-notice');
+SELECT injection_points_attach('planner-add-path-reject', 'path-prune-notice');
+SELECT injection_points_attach('planner-add-path-displace', 'path-prune-notice');
+SET max_parallel_workers_per_gather = 0;
+SET enable_hashjoin = off;
+SET enable_mergejoin = off;
+EXPLAIN (COSTS OFF) SELECT o.id FROM ppc c JOIN ppo o ON o.customer_id = c.id
+ WHERE c.id BETWEEN 1 AND 5;
+};
+
+my ($result, $stdout, $stderr) = $node->psql('postgres', $query);
+is($result, 0, 'query with path pruning points attached succeeds');
+
+like($stderr, qr/PLANNER_PATH event=accept/, 'an accepted path is reported');
+like(
+	$stderr,
+	qr/PLANNER_PATH event=(reject|displace)/,
+	'a pruned path is reported');
+like($stderr, qr/new_required_outer=\{\d+/,
+	'a parameterized candidate is reported with a non-empty required_outer');
+like(
+	$stderr,
+	qr/new_type=IndexScan new_index=[1-9]\d*/,
+	'an index path is reported with its index');
+
+# The precheck boundary reports a candidate that has no Path yet, so its
+# line has a different shape.
+my $precheck = q{
+SELECT injection_points_set_local();
+SELECT injection_points_attach('planner-add-path-precheck-reject',
+                               'path-prune-notice');
+SET max_parallel_workers_per_gather = 0;
+EXPLAIN (COSTS OFF) SELECT o.id FROM ppc c JOIN ppo o ON o.customer_id = c.id
+ JOIN ppc d ON d.id = c.id;
+};
+my ($r2, $out2, $err2) = $node->psql('postgres', $precheck);
+is($r2, 0, 'query with the precheck point attached succeeds');
+like(
+	$err2,
+	qr/PLANNER_PATH event=precheck-reject/,
+	'a precheck rejection is reported');
+
+$node->stop;
+done_testing();
-- 
