From 1873897525e829c8c93d8d9acb1db2a3cd8371c4 Mon Sep 17 00:00:00 2001
From: r2d2 <r2d2@localhost>
Date: Tue, 8 Sep 2026 14:39:51 +0000
Subject: [PATCH 2/2] injection_points: add a callback for planner path pruning

The existing "notice" callback treats the injection point argument as a
string, so attaching it to a point that passes a typed argument prints
garbage.  Add "notice-path", which interprets the argument as a
PathPruningInfo and reports the relation, the node tag, the number of
pathkeys and required_outer.

This makes the path pruning injection points usable from SQL without adding
a separate test module, and keeps the decision about how to render the
payload in the test module rather than in the planner.
---
 .../injection_points/injection_points.c       | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/src/test/modules/injection_points/injection_points.c b/src/test/modules/injection_points/injection_points.c
index 66d8158..508063c 100644
--- a/src/test/modules/injection_points/injection_points.c
+++ b/src/test/modules/injection_points/injection_points.c
@@ -17,6 +17,8 @@
 
 #include "postgres.h"
 
+#include "optimizer/pathnode.h"
+
 #include "fmgr.h"
 #include "funcapi.h"
 #include "injection_points.h"
@@ -78,6 +80,9 @@ extern PGDLLEXPORT void injection_error(const char *name,
 extern PGDLLEXPORT void injection_notice(const char *name,
 										 const void *private_data,
 										 void *arg);
+extern PGDLLEXPORT void injection_notice_path(const char *name,
+											  const void *private_data,
+											  void *arg);
 extern PGDLLEXPORT void injection_wait(const char *name,
 									   const void *private_data,
 									   void *arg);
@@ -206,6 +211,56 @@ injection_error(const char *name, const void *private_data, void *arg)
 		elog(ERROR, "error triggered for injection point %s", name);
 }
 
+/*
+ * injection_notice_path
+ *
+ * Callback for the planner path pruning injection points.  Unlike
+ * injection_notice(), which expects a string, this one interprets the
+ * argument as a PathPruningInfo and reports the properties that matter when
+ * asking why a given path did not survive.
+ */
+void
+injection_notice_path(const char *name, const void *private_data, void *arg)
+{
+	PathPruningInfo *info = (PathPruningInfo *) arg;
+	StringInfoData relids;
+	StringInfoData outer;
+	int			x;
+	bool		first;
+
+	if (info == NULL)
+	{
+		elog(NOTICE, "%s: no path information", name);
+		return;
+	}
+
+	initStringInfo(&relids);
+	x = -1;
+	first = true;
+	while ((x = bms_next_member(info->rel->relids, x)) >= 0)
+	{
+		appendStringInfo(&relids, "%s%d", first ? "" : " ", x);
+		first = false;
+	}
+
+	initStringInfo(&outer);
+	x = -1;
+	first = true;
+	while ((x = bms_next_member(PATH_REQ_OUTER(info->path), x)) >= 0)
+	{
+		appendStringInfo(&outer, "%s%d", first ? "" : " ", x);
+		first = false;
+	}
+
+	elog(NOTICE, "%s: rel {%s} node %d pathkeys %d req_outer {%s}%s",
+		 name, relids.data, (int) info->path->pathtype,
+		 list_length(info->path->pathkeys), outer.data,
+		 info->dominator ? " by-dominator" : "");
+
+	pfree(relids.data);
+	pfree(outer.data);
+}
+
 void
 injection_notice(const char *name, const void *private_data, void *arg)
 {
@@ -333,6 +388,8 @@ injection_points_attach(PG_FUNCTION_ARGS)
 		function = "injection_error";
 	else if (strcmp(action, "notice") == 0)
 		function = "injection_notice";
+	else if (strcmp(action, "notice-path") == 0)
+		function = "injection_notice_path";
 	else if (strcmp(action, "wait") == 0)
 		function = "injection_wait";
 	else
